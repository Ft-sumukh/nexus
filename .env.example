# ==============================================================================
# NEXUS - Environment Configuration Template
# Copy this file to .env before starting the application: cp .env.example .env
# Never commit .env with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
APP_NAME=nexus
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# HTTP & Network Security
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# Secrets & Cryptographic Keys (Required in production)
# In development, default fallback keys are accepted for local convenience.
# Generate strong random strings for production: openssl rand -base64 32
# ------------------------------------------------------------------------------
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars-long!
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars-long!
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------------------------
# Database Persistence (Target: PostgreSQL) - Required in Phase 4+
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# Multi-Tenancy (Phase 4+)
# Options: shared-table (default) | schema-per-tenant
# ------------------------------------------------------------------------------
TENANCY_MODE=shared-table

# ------------------------------------------------------------------------------
# AI Provider Stubs (Phase 10+) - Abstracted via Ports & Adapters
# ------------------------------------------------------------------------------
# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_DEFAULT_MODEL=gemini-2.5-pro
