# Multi-stage Dockerfile for NEXUS TITAN Python API Service
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies for C++ compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir .

COPY CMakeLists.txt .
COPY systems/ systems/
RUN cmake -G Ninja -B build -DCMAKE_BUILD_TYPE=Release -DTITAN_ENABLE_CUDA=OFF \
    && cmake --build build

FROM python:3.12-slim AS runner

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/build/systems/test_hardware_probe /app/build/systems/test_hardware_probe

COPY ai/ ai/
COPY apps/ apps/

EXPOSE 8000

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
